{
	"name": "@os-eco/sapling-cli",
	"version": "0.3.2",
	"description": "Headless coding agent with proactive context management",
	"author": "Jaymin West",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/jayminwest/sapling.git"
	},
	"homepage": "https://github.com/jayminwest/sapling",
	"keywords": [
		"ai",
		"agents",
		"cli",
		"developer-tools",
		"coding-agent",
		"context-management"
	],
	"bin": {
		"sp": "./src/index.ts",
		"sapling": "./src/index.ts"
	},
	"main": "src/index.ts",
	"files": [
		"src",
		"agents"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.0"
	},
	"scripts": {
		"test": "bun test",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"check:agents": "bun run scripts/validate-agents-md.ts",
		"check:dups": "bunx jscpd",
		"check:deps": "knip --dependencies",
		"check:size": "bun run scripts/check-file-sizes.ts",
		"check:debt": "bun run scripts/check-debt-markers.ts",
		"check:coverage": "bun run scripts/check-coverage.ts",
		"check:ci-parity": "bun scripts/check-ci-parity.ts",
		"check:all": "bun scripts/check-all.ts",
		"verify": "bun run check:all",
		"version:bump": "bun scripts/version-bump.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.83.0",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"chalk": "^5.6.2",
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@types/bun": "latest",
		"knip": "^6.14.2",
		"typescript": "^5.9.0",
		"yaml": "^2.6.0"
	},
	"optionalDependencies": {
		"@anthropic-ai/sdk": "^0.39.0"
	}
}
